# MySQL Database Configuration
DATABASE_URL=mysql+mysqlconnector://username:password@localhost:3306/database_name

# Flask Configuration
FLASK_DEBUG=True
FLASK_ENV=development

# Secrets (generate real values per environment - do not commit actual secrets)
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
# Must be a urlsafe-base64-encoded 32-byte key, e.g. output of:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me
